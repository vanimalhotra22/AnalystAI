# Copy to .env and edit.  Every value here has a working default, so the app
# runs with no .env file at all.

# ---------------------------------------------------------------- data layer
# Default: a SQLite file at ./data/insightpilot.db (zero setup).
# DATABASE_URL=sqlite:///./data/insightpilot.db
#
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg://insight:insight@localhost:5432/insightpilot
#
# The agent's SQL tool uses a separate, read-only connection.  With Postgres,
# point this at a role that only has SELECT grants:
# READONLY_DATABASE_URL=postgresql+psycopg://insight_ro:insight_ro@localhost:5432/insightpilot

# ---------------------------------------------------------------------- LLM
# "auto" uses whichever provider has a key, and falls back to the deterministic
# planner when none does.  Set to "none" to force the deterministic planner.
LLM_PROVIDER=auto
LLM_MODEL=claude-sonnet-5

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# ---------------------------------------------------------------------- auth
# Signing key for session cookies. Unset falls back to a development key and the
# API logs a warning at startup. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
SESSION_MINUTES=720
COOKIE_NAME=insightpilot_session
# Set true when serving over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false
# Set "none" for cross-site cookies (e.g. Vercel frontend calling Render backend)
COOKIE_SAMESITE=lax
# Comma-separated list of allowed frontend origins (e.g. https://my-app.vercel.app)
# CORS_ORIGINS=
# One-click demo sign-in (no password typed during a walkthrough).
DEMO_ACCOUNT_ENABLED=true
DEMO_EMAIL=demo@insightpilot.local
DEMO_PASSWORD=insight-demo-2026

# ------------------------------------------------------------------- agent
MAX_INVESTIGATION_STEPS=14
SQL_ROW_LIMIT=5000

# --------------------------------------------------------- data generation
SEED=20260824
HISTORY_START=2025-01-01
HISTORY_END=2026-07-31
